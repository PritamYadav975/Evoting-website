<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Organization Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/register.css">
</head>

<body>
    <main class="container registration-page">
        <div class="registration-card card border-0 shadow-sm">
            <div class="card-body p-3 p-md-4">
                
                <div class="mb-3">
                    <h1 class="h3 mb-1">Organization Registration</h1>
                    <p class="text-secondary mb-0">Create an account to manage your elections.</p>
                </div>

                <form action="/auth/register" method="POST">
                    <div class="mb-2">
                        <label class="form-label" for="name">Organization Name</label>
                        <input class="form-control" type="text" id="name" name="name" autocomplete="organization" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" autocomplete="username" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" type="email" id="email" name="email" autocomplete="email" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" autocomplete="new-password" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="resultsPassword">Results Password</label>
                        <input class="form-control" type="password" id="resultsPassword" name="resultsPassword" autocomplete="new-password" required>
                    </div>

                    <button class="btn btn-primary w-100 py-1 fw-semibold" type="submit">Register</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>